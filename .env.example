# Local development only. Copy this file to .env and replace every placeholder.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL connection. Create this database and user locally before running migrate.
DB_NAME=market_data
DB_USER=root
DB_PASSWORD=required_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_market_interview_lab

# JWT token lifetimes. Note: settings.py defaults to 30 minutes if
# JWT_ACCESS_MINUTES is unset, so set it here explicitly to avoid ambiguity.
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# Celery broker. Redis only: there is deliberately no result backend, because
# IngestionJob is the durable record of what a load did. See docs/celery_async.md.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND is intentionally unset.

# Worker retry and liveness knobs. Defaults shown; uncomment to override.
# CELERY_TASK_TIME_LIMIT=1800
# CELERY_TASK_SOFT_TIME_LIMIT=1500
# CELERY_TASK_ALWAYS_EAGER=False
# INGESTION_MAX_RETRIES=5
# INGESTION_RETRY_BACKOFF_SECONDS=10
# INGESTION_RETRY_BACKOFF_MAX_SECONDS=900
# INGESTION_STALE_AFTER_SECONDS=900
# INGESTION_HEARTBEAT_SECONDS=5
