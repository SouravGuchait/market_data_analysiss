# Local development only. Copy this file to .env and replace every placeholder.
DJANGO_SECRET_KEY=replace-with-a-unique-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL connection. Create this database and user locally before running migrate.
DB_NAME=market_interview_lab
DB_USER=root
DB_PASSWORD=required_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_market_interview_lab

# JWT token lifetimes.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
